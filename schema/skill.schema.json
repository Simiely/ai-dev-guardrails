{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/guardrails/skill.schema.json",
  "title": "manual chapter SKILL.md frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "when_to_use", "when_not_to_use"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 500
    },
    "when_to_use": {
      "type": "array",
      "items": { "type": "string", "minLength": 2 },
      "minItems": 1
    },
    "when_not_to_use": {
      "type": "array",
      "items": { "type": "string", "minLength": 2 },
      "minItems": 1
    },
    "globs": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "inputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "outputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "checks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "token_budget": {
      "type": "integer",
      "minimum": 100,
      "maximum": 5000
    },
    "related": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "allowed-tools": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
